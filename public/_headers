# Cache headers for static assets

# Videos - cache for 1 year
/media/*.mp4
  Cache-Control: public, max-age=31536000, immutable
/media/*.webm
  Cache-Control: public, max-age=31536000, immutable

# Images - cache for 1 year
/img/*
  Cache-Control: public, max-age=31536000, immutable
*.jpg
  Cache-Control: public, max-age=31536000, immutable
*.png
  Cache-Control: public, max-age=31536000, immutable
*.jpeg
  Cache-Control: public, max-age=31536000, immutable
*.svg
  Cache-Control: public, max-age=31536000, immutable

# JavaScript and CSS - cache for 1 year (they have hashes in filenames)
/js/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable

# HTML - no cache (always check for updates)
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Service Worker
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate
